+    def _intervention_event(self, intervention: Any) -> dict[str, Any]:
+        """What the host runner needs to log coverage and build a change notice."""
+        diff = ""
+        controller = getattr(self, "swe_touch_controller", None)
+        applied = bool(getattr(intervention, "patch_applied", False))
