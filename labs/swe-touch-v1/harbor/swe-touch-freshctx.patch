+def _freshctx_bridge(env: HarborBridgeEnvironment, output_path: Path) -> Any | None:
+    """FreshCtx arms (freshctx-research labs/swe-touch-v1). None when disabled."""
+    mode = os.environ.get("FRESHCTX_MODE", "off")
+    raw_notice = os.environ.get("FRESHCTX_NOTICE", "0")
+    notice = {"0": "off", "1": "once"}.get(raw_notice, raw_notice)  # off | once | persist
+    if mode == "off" and notice == "off":
+        return None
+    import sys
+    import tempfile
+
+    sys.path.insert(0, os.environ["FRESHCTX_BRIDGE_DIR"])
+    from freshctx_mini import DEFAULT_BUDGET_BYTES, MiniBridge
+
+    mirror = Path(tempfile.mkdtemp(prefix="freshctx-mirror-"))
+    return MiniBridge(
+        mirror_root=mirror,
+        repo_root=os.environ.get("FRESHCTX_REPO_ROOT", "/testbed"),
+        internal_exec=env.internal_exec,
+        mode=mode,
+        notice=notice,
+        session_id=output_path.parent.name,
+        budget_bytes=int(os.environ.get("FRESHCTX_BUDGET_BYTES", DEFAULT_BUDGET_BYTES)),
+        refresh=os.environ.get("FRESHCTX_REFRESH", "all"),
+        log_path=output_path.parent / "freshctx.jsonl",
+        audit_path=output_path.parent / "freshctx-audit.jsonl",
+    )
