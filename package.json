{
  "name": "freshctx",
  "version": "0.1.0",
  "description": "A live, versioned context layer for coding agents.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:docs": "node --test test/living-docs.test.mjs test/ise-vocabulary.test.mjs test/layout-contract.test.mjs test/gotchas-contract.test.mjs test/manifests.test.mjs",
    "test:py": "python3 -m unittest discover -s test/python -p 'test_*.py'",
    "bench": "node bench/run.mjs",
    "ctxbench": "node bench/ctxbench.mjs",
    "ctxbench:smoke": "node bench/smoke.mjs",
    "ctxbench:holdout": "node bench/holdout.mjs",
    "ctxbench:pi-smoke": "node bench/pi-smoke.mjs",
    "ctxbench:hermes-smoke": "node bench/hermes-smoke.mjs",
    "ctxbench:pi-holdout": "node bench/pi-holdout.mjs",
    "ctxbench:hermes-holdout": "node bench/hermes-holdout.mjs",
    "ctxbench:adapters-holdout": "node bench/adapters-holdout.mjs",
    "capture-provider": "node capture/provider.mjs",
    "evaluate": "node autoresearch/evaluate.mjs",
    "evaluate:check-docs": "node scripts/check-recorded-evaluation.mjs",
    "demo": "node examples/demo.mjs",
    "papers:list": "node scripts/papers.mjs list",
    "papers:fetch": "node scripts/papers.mjs fetch",
    "papers:fetch:all": "node scripts/papers.mjs fetch --all",
    "papers:verify": "node scripts/papers.mjs verify",
    "repos:fetch": "node scripts/repos.mjs fetch",
    "repos:fetch:smoke": "node scripts/repos.mjs fetch --tier=smoke",
    "repos:fetch:holdout": "node scripts/repos.mjs fetch --ids=go-tools,neovim",
    "repos:verify": "node scripts/repos.mjs verify",
    "hosts:fetch": "node scripts/hosts.mjs fetch",
    "hosts:verify": "node scripts/hosts.mjs verify",
    "ctxbench:native-holdout": "node bench/native-holdout.mjs",
    "ctxbench:native-budget-pressure": "node bench/native-budget-pressure.mjs",
    "ctxbench:budget-pressure-hermes-fresh": "node bench/budget-pressure-hermes-fresh.mjs",
    "ctxbench:budget-pressure-adapter-prune": "node bench/budget-pressure-adapter-prune.mjs",
    "ctxbench:holdout-adapter-bakeoff": "node bench/holdout-adapter-bakeoff.mjs",
    "ctxbench:symbol-pack": "node bench/generate-symbol-pack.mjs",
    "ctxbench:apex-pack": "node bench/generate-apex-pack.mjs",
    "holdout:freeze": "node scripts/holdout-protocol.mjs freeze",
    "holdout:generate": "node scripts/holdout-protocol.mjs generate",
    "holdout:run": "node scripts/holdout-protocol.mjs run",
    "holdout:report": "node scripts/holdout-protocol.mjs report",
    "holdout:verify": "node scripts/holdout-verify.mjs",
    "holdout:ci-guard": "node scripts/holdout-ci-guard.mjs",
    "holdout:attest-stub": "node scripts/holdout-attest-stub.mjs",
    "hermes:install": "node adapters/hermes/install.mjs",
    "hermes:verify-layout": "node adapters/hermes/verify-layout.mjs",
    "ise:install": "npm --prefix ise/treesitter ci --omit=dev",
    "check": "node --check src/*.mjs && node --check bench/*.mjs && node --check autoresearch/*.mjs && node --check examples/*.mjs && node --check scripts/*.mjs && node --check capture/*.mjs && node --check adapters/*.mjs && node --check adapters/pi/replay.mjs && node --check adapters/hermes/bridge.mjs && node --check adapters/hermes/replay.mjs && node --check adapters/hermes/install.mjs && node --check adapters/hermes/verify-layout.mjs && node --check ise/treesitter/*.mjs && python3 -m py_compile bench/hermes-native-bridge.py bench/python-ast-oracle.py adapters/hermes/__init__.py"
  },
  "keywords": [
    "agents",
    "context-engineering",
    "coding-agents",
    "autoresearch",
    "llm"
  ]
}
