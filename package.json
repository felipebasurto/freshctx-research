{
  "name": "freshctx",
  "version": "0.1.0",
  "description": "A live, versioned context layer for coding agents.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "bench": "node bench/run.mjs",
    "ctxbench": "node bench/ctxbench.mjs",
    "ctxbench:smoke": "node bench/smoke.mjs",
    "ctxbench:holdout": "node bench/holdout.mjs",
    "ctxbench:pi-smoke": "node bench/pi-smoke.mjs",
    "ctxbench:hermes-smoke": "node bench/hermes-smoke.mjs",
    "ctxbench:pi-holdout": "node bench/pi-holdout.mjs",
    "ctxbench:hermes-holdout": "node bench/hermes-holdout.mjs",
    "ctxbench:adapters-holdout": "node bench/adapters-holdout.mjs",
    "capture-provider": "node capture/provider.mjs",
    "evaluate": "node autoresearch/evaluate.mjs",
    "demo": "node examples/demo.mjs",
    "papers:list": "node scripts/papers.mjs list",
    "papers:fetch": "node scripts/papers.mjs fetch",
    "papers:fetch:all": "node scripts/papers.mjs fetch --all",
    "papers:verify": "node scripts/papers.mjs verify",
    "repos:fetch": "node scripts/repos.mjs fetch",
    "repos:fetch:smoke": "node scripts/repos.mjs fetch --tier=smoke",
    "repos:fetch:holdout": "node scripts/repos.mjs fetch --ids=go-tools,neovim",
    "repos:verify": "node scripts/repos.mjs verify",
    "holdout:freeze": "node scripts/holdout-protocol.mjs freeze",
    "holdout:generate": "node scripts/holdout-protocol.mjs generate",
    "holdout:run": "node scripts/holdout-protocol.mjs run",
    "holdout:report": "node scripts/holdout-protocol.mjs report",
    "check": "node --check src/*.mjs && node --check bench/*.mjs && node --check autoresearch/*.mjs && node --check examples/*.mjs && node --check scripts/*.mjs && node --check capture/*.mjs && node --check adapters/pi/replay.mjs && node --check adapters/hermes/bridge.mjs && node --check adapters/hermes/replay.mjs"
  },
  "keywords": [
    "agents",
    "context-engineering",
    "coding-agents",
    "autoresearch",
    "llm"
  ]
}
